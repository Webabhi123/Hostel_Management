
@model IEnumerable<Hostel_Management.Models.Meeting>;
@{
    ViewData["Title"] = "GetMeetingInfo";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutSideNavbar.cshtml";
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>PhoneNumber</th>
            <th>City</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>@item.PhoneNumber</td>
                <td>@item.City</td>
                <td>
                    @Html.ActionLink("Send_Email", "Send", new { id = item.Id }, new { @class = "btn btn-warning" })
                </td>
            </tr>
        }
    </tbody>
</table>

