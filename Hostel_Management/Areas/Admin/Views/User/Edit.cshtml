@model Hostel_Management.Models.User;
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutSideNavbar.cshtml";
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        @Html.LabelFor(u => u.UserName, new { @class = "col-md-2 control-label" })
        <div class="col-md-4">
            @Html.TextBoxFor(u => u.UserName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(u => u.UserEmail, new { @class = "col-md-2 control-label" })
        <div class="col-md-4">
            @Html.TextBoxFor(u => u.UserEmail, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(u => u.Phonenumber, new { @class = "col-md-2 control-label" })
        <div class="col-md-4">
            @Html.TextBoxFor(u => u.Phonenumber, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(u => u.Password, new { @class = "col-md-2 control-label" })
        <div class="col-md-4">
            @Html.PasswordFor(u => u.Password, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <a href="/Admin/User/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

