@model IEnumerable<Hostel_Management.Models.User>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutSideNavbar.cshtml";
}

<table class="table">
    <thead>
        <tr>
            <th>UserName</th>
            <th>UserEmail</th>
            <th>Phonenumber</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.UserEmail</td>
                <td>@item.Phonenumber</td>
                <td>
                    @* <!-- Edit Button -->
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                <!-- Delete Button -->
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form> *@
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger delete-link", data_id = item.Id })

                </td>
            </tr>
        }
    </tbody>
</table>

<script>

    $(document).ready(function () {
        $(".delete-link").on("click", function (e) {
            e.preventDefault();
            var id = $(this).data("id");
            var confirmation = confirm("are you sure do you want to delete this?");

            if (confirmation) {
                window.location.href = "/Admin/User/Delete?id=" + id;
            }

        })
    })
</script>

