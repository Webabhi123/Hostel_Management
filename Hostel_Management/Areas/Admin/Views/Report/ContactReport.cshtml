@model IEnumerable<Hostel_Management.Models.Contact>
@{
    ViewData["Title"] = "ContactReport";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutSideNavbar.cshtml";
}

<h1>ContactReport</h1>
<div align="right">
    <a href="/Admin/Report/ExportContactReport" class="btn btn-secondary">Export Report</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Name of the Person</th>
            <th>Email</th>
            <th>Message</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Message</td>
            </tr>
        }
    </tbody>
</table>

