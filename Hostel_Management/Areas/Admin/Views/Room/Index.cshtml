@model IEnumerable<Hostel_Management.Models.Room>;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutSideNavbar.cshtml";
}

<p>
    @Html.ActionLink("Create", "Create", new { area = "Admin", controller = "Room" }, new { @class = "btn btn-info" })
</p>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>RoomNumber</th>
            <th>Capacity</th>
            <th>IsOccupied</th>
            <th>Pricepermonth</th>
            @* <th>Description</th> *@
            <th>Room Type</th>
            <th>Image</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RoomId</td>
                <td>@item.RoomNumber</td>
                <td>@item.Capacity</td>
                <td>@item.IsOccupied</td>
                <td>@item.PricePerMonth</td>
                @* <td>@item.Description</td> *@
                <td>@item.RoomType</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@item.Image" alt="Room Image" style="max-width: 100px; max-height: 100px;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
                <td>
                    @* <!-- Edit Button -->
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                <!-- Delete Button -->
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form> *@
                    @Html.ActionLink("Edit", "Edit", new { id = item.RoomId }, new { @class = "btn btn-warning" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.RoomId }, new { @class = "btn btn-danger delete-link", data_id = item.RoomId })

                </td>
            </tr>
        }
    </tbody>
</table>
<script>

    $(document).ready(function () {
        $(".delete-link").on("click", function (e) {
            e.preventDefault();
            var id = $(this).data("id");
            var confirmation = confirm("are you sure do you want to delete this?");

            if (confirmation) {
                window.location.href = "/Admin/Room/Delete?id=" + id;
            }

        })
    })
</script>

